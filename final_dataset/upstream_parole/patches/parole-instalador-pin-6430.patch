+      fi
+      RELEASE_TAG="$PRAAT_TAG"
+      echo "🔍 Praat fijado en ${PRAAT_TAG} (${ARCH_SUFFIX_LIST})…"
     fi
 
     PRAAT_FILE=$(basename "$PRAAT_URL")
